# ClipMesh Environment Configuration Example
# Copy to .env for local development

# Server network binding
CLIPMESH_HOST=0.0.0.0
CLIPMESH_PORT=8080
CLIPMESH_ENV=development

# Database configuration (PostgreSQL 17)
DATABASE_URL=postgres://clipmesh:clipmesh_secret@localhost:5432/clipmesh_db
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5

# Redis configuration (Transient state, presence, rate limits)
REDIS_URL=redis://localhost:6379/0

# JWT & Authentication
JWT_SECRET=super-secret-development-jwt-key-minimum-32-chars-long!
JWT_ACCESS_EXPIRY_SECS=900
JWT_REFRESH_EXPIRY_SECS=2592000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://tauri.localhost

# Logging & Observability
RUST_LOG=info,clipmesh_server=debug,clipmesh_core=debug
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

